server {
    listen 80;
    server_name localhost;

    # Localização padrão para servir a aplicação Vue
    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy para o backend
    # Qualquer chamada para /api/... será redirecionada
location /api/ {
        # 1. Aponta para o servidor de DNS interno do Docker.
        resolver 127.0.0.11 valid=10s;
        
        # 2. Usa uma variável para que o Nginx resolva o DNS dinamicamente.
        set $upstream_url http://${BACKEND_URL};
        proxy_pass $upstream_url;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}